# Supabase project credentials. Copy to .env; the EXPO_PUBLIC_ prefix is what
# makes them reachable from the client bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the web app is hosted, for the links a club official sends round.
# Without it the app shares the public-pages edge function URL, which works but
# is uglier. On web it falls back to the origin it is being served from.
EXPO_PUBLIC_SITE_URL=https://league.example.org
