{
  "expo": {
    "name": "World Shooting League",
    "slug": "world-shooting-league",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wsl",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D13"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worldshootingleague.app",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.worldshootingleague.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B0D13"
      },
      "edgeToEdgeEnabled": true,
      "userInterfaceStyle": "automatic"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Die App braucht die Kamera, um ein Foto der Anzeige oder des Ausdrucks als Nachweis aufzunehmen."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
